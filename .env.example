# Server
PORT=5000
NODE_ENV=development

# Frontend (set in client/.env for local development or hosting settings)
VITE_API_URL=http://localhost:5000/api

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/trendcommerce

# JWT
JWT_ACCESS_SECRET=your-access-secret
JWT_REFRESH_SECRET=your-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=trendcommerce
